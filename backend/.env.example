# backend/.env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Ollama (Local Mode) ─────────────────────────────────────────────────────────
# URL of your Ollama server.
# If running Ollama inside WSL, find the WSL IP with:
#   ip addr show eth0 | grep "inet " | awk '{print $2}' | cut -d/ -f1
OLLAMA_BASE_URL=http://172.26.18.7:11434

# The Ollama model name (must be pulled first: ollama pull gemma3:270m)
OLLAMA_MODEL=gemma3:270m

# ── OpenAI (Cloud Mode) ─────────────────────────────────────────────────────────
# Your OpenAI API key — leave blank to disable Cloud mode entirely.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model for both chat responses and JSON-mode insight extraction
OPENAI_MODEL=gpt-4o-mini
